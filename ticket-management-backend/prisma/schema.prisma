datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  tickets   Ticket[]
  createdAt DateTime @default(now())
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   // 'OPEN', 'IN_PROGRESS', 'RESOLVED'
  assigneeId  Int?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
}